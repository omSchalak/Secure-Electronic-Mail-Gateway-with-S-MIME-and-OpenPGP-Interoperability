# ==============================================================================
# SECURE ELECTRONIC MAIL GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE
# Project: Secure Electronic Mail Gateway with S/MIME and OpenPGP Interoperability
# Creator: Mansi Chalak
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origin for Client Application
ALLOWED_ORIGIN=http://localhost:5173

# Gateway Domain Identity
GATEWAY_DOMAIN=mailsec.internal
GATEWAY_OPERATOR_EMAIL=gateway@mailsec.internal
GATEWAY_ROOT_CA_NAME="Mail Security Gateway Interop CA"

# Security Policy Flags
ENFORCE_ZERO_TRUST_PLAINTEXT_DROP=true
ALLOW_UNANCHORED_DEMO_CERTS=true
AUDIT_LOG_RETENTION_MAX=200
